# Dev environment — copy to .env (gitignored).
# Used both by the venv workflow (source it / export vars) and by
# `docker compose up` for the retriever container.

# ── Ingestion (dev-only, venv workflow — not used by the retriever) ──
# Claude enrichment; leave unset to run `pipeline.py ingest --no-enrich`
ANTHROPIC_API_KEY=

# Enrichment uses the Message Batches API (50% off) by default;
# set ENRICH_SYNC=1 to force per-doc synchronous calls instead
#ENRICH_SYNC=1

# ── Retriever sidecar ──
# Defaults match the Dockerfile; only set these to diverge.
#RETRIEVER_HOST=127.0.0.1
#RETRIEVER_PORT=8001
# Only relevant outside Docker; in the container the compose mount fixes this.
#VECTORDB_DIR=./data/vectordb
